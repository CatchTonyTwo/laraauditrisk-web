---
import Base from '../../layouts/Base.astro';
const title = "Matriz de diagnóstico de brechas — Lara Audit Risk Advisory";
const description = "Matriz editable para diagnosticar brechas frente a las Normas Globales de Auditoría Interna 2024.";
---
<Base title={title} description={description} active="herramientas">

<section class="page-hero product-hero">
  <div class="page-hero-inner">
    <hr class="rule rule--light" data-reveal>
    <span class="hero-eyebrow" data-reveal><span data-lang="es">Herramienta de pago · Excel + PDF</span><span data-lang="en">Paid tool · Excel + PDF</span></span>
    <h1 data-reveal><span data-lang="es">Matriz de diagnóstico de brechas — Normas 2024</span><span data-lang="en">2024 Standards gap assessment matrix</span></h1>
    <p data-reveal data-delay="1"><span data-lang="es">Una estructura editable para evaluar su función de auditoría, organizar evidencia y convertir las brechas en un plan defendible.</span><span data-lang="en">An editable framework to assess your audit function, organize evidence and turn gaps into a defensible plan.</span></p>
  </div>
</section>

<section class="product-preview section--cream">
  <div class="container">
    <div class="preview-heading" data-reveal>
      <div><span class="eyebrow"><span data-lang="es">Vista previa</span><span data-lang="en">Preview</span></span><h2><span data-lang="es">Una herramienta clara desde la primera hoja.</span><span data-lang="en">A tool designed for clarity from the first sheet.</span></h2></div>
      <p><span data-lang="es">Mockup y contenido ilustrativo. Las capturas finales se actualizarán con el archivo definitivo.</span><span data-lang="en">Illustrative mockup and sample content. Final screenshots will be updated with the finished file.</span></p>
    </div>
    <div class="preview-stage">
      <div class="product-mockup" data-reveal>
        <div class="product-mockup__book">
          <span class="product-mockup__brand">LARA · ARA</span>
          <span class="product-mockup__eyebrow"><span data-lang="es">Herramienta profesional</span><span data-lang="en">Professional tool</span></span>
          <strong><span data-lang="es">Matriz de diagnóstico de brechas</span><span data-lang="en">Gap assessment matrix</span></strong>
          <small><span data-lang="es">Normas Globales de Auditoría Interna 2024</span><span data-lang="en">2024 Global Internal Audit Standards</span></small>
          <i></i>
        </div>
        <div class="product-mockup__sheet"><span>Excel</span><b>01</b><b>02</b><b>03</b><b>04</b></div>
      </div>

      <div class="sample-screen" data-reveal data-delay="1">
        <div class="sample-screen__top"><span></span><span></span><span></span><b>Diagnóstico_Normas_2024.xlsx</b></div>
        <div class="sample-tabs"><span class="active"><span data-lang="es">Diagnóstico</span><span data-lang="en">Assessment</span></span><span><span data-lang="es">Evidencias</span><span data-lang="en">Evidence</span></span><span><span data-lang="es">Plan de acción</span><span data-lang="en">Action plan</span></span></div>
        <div class="sample-table">
          <div class="sample-row sample-row--head"><span><span data-lang="es">Dominio</span><span data-lang="en">Domain</span></span><span><span data-lang="es">Principio</span><span data-lang="en">Principle</span></span><span><span data-lang="es">Estado</span><span data-lang="en">Status</span></span><span><span data-lang="es">Evidencia</span><span data-lang="en">Evidence</span></span><span><span data-lang="es">Prioridad</span><span data-lang="en">Priority</span></span></div>
          <div class="sample-row"><span>I</span><span><span data-lang="es">Propósito</span><span data-lang="en">Purpose</span></span><span><i class="status status--good"></i><span data-lang="es">Conforme</span><span data-lang="en">Conforms</span></span><span>4 / 4</span><span><em class="priority priority--low"><span data-lang="es">Baja</span><span data-lang="en">Low</span></em></span></div>
          <div class="sample-row"><span>II</span><span><span data-lang="es">Ética</span><span data-lang="en">Ethics</span></span><span><i class="status status--warn"></i><span data-lang="es">Parcial</span><span data-lang="en">Partial</span></span><span>3 / 5</span><span><em class="priority priority--mid"><span data-lang="es">Media</span><span data-lang="en">Medium</span></em></span></div>
          <div class="sample-row"><span>III</span><span><span data-lang="es">Gobierno</span><span data-lang="en">Governance</span></span><span><i class="status status--risk"></i><span data-lang="es">Brecha</span><span data-lang="en">Gap</span></span><span>2 / 6</span><span><em class="priority priority--high"><span data-lang="es">Alta</span><span data-lang="en">High</span></em></span></div>
          <div class="sample-row"><span>IV</span><span><span data-lang="es">Gestión</span><span data-lang="en">Managing</span></span><span><i class="status status--good"></i><span data-lang="es">Conforme</span><span data-lang="en">Conforms</span></span><span>5 / 5</span><span><em class="priority priority--low"><span data-lang="es">Baja</span><span data-lang="en">Low</span></em></span></div>
        </div>
        <div class="sample-summary"><div><b>78%</b><span><span data-lang="es">Conformidad global</span><span data-lang="en">Overall conformity</span></span></div><div><b>12</b><span><span data-lang="es">Acciones abiertas</span><span data-lang="en">Open actions</span></span></div><div><b>4</b><span><span data-lang="es">Prioridad alta</span><span data-lang="en">High priority</span></span></div></div>
      </div>
    </div>
  </div>
</section>

<section class="section section--paper">
  <div class="container">
    <div class="product-layout">
      <article class="product-copy" data-reveal>
        <h2><span data-lang="es">Diagnosticar no es marcar casillas.</span><span data-lang="en">A diagnosis is more than ticking boxes.</span></h2>
        <p><span data-lang="es">La matriz está diseñada para que cada conclusión tenga una norma, una evidencia y una acción asociada. Le ayuda a ver el estado real de su función antes de una evaluación externa y a explicar las prioridades al Comité.</span><span data-lang="en">The matrix is designed so every conclusion is tied to a standard, evidence and an action. It helps you see the true state of your function before an external assessment and explain priorities to the Committee.</span></p>

        <h2><span data-lang="es">Qué incluye</span><span data-lang="en">What is included</span></h2>
        <ul class="product-list">
          <li><span data-lang="es">Evaluación organizada por dominio y principio de las Normas Globales 2024.</span><span data-lang="en">Assessment organized by domain and principle of the 2024 Global Standards.</span></li>
          <li><span data-lang="es">Registro de evidencia, responsable y ubicación de cada soporte.</span><span data-lang="en">Evidence register with owner and location for every supporting item.</span></li>
          <li><span data-lang="es">Clasificación de brechas por prioridad, impacto y esfuerzo.</span><span data-lang="en">Gap classification by priority, impact and effort.</span></li>
          <li><span data-lang="es">Plan de acción con responsables, fechas y seguimiento.</span><span data-lang="en">Action plan with owners, dates and progress tracking.</span></li>
          <li><span data-lang="es">Resumen ejecutivo para presentar resultados al Comité.</span><span data-lang="en">Executive summary for presenting results to the Committee.</span></li>
          <li><span data-lang="es">Guía breve de uso y criterios de adaptación.</span><span data-lang="en">Concise user guide and adaptation criteria.</span></li>
        </ul>

        <h2><span data-lang="es">Para quién está pensada</span><span data-lang="en">Who it is for</span></h2>
        <p><span data-lang="es">Para Directores Ejecutivos de Auditoría, responsables de calidad y equipos que necesitan preparar su función frente a las Normas Globales 2024 sin empezar desde una hoja en blanco.</span><span data-lang="en">For Chief Audit Executives, quality leaders and teams that need to prepare their function against the 2024 Global Standards without starting from a blank page.</span></p>

        <h2><span data-lang="es">Qué no hace</span><span data-lang="en">What it does not do</span></h2>
        <p><span data-lang="es">No sustituye el juicio profesional ni constituye una evaluación externa. Es una herramienta de trabajo para ordenar el análisis, documentar decisiones y preparar conversaciones de calidad.</span><span data-lang="en">It does not replace professional judgment or constitute an external assessment. It is a working tool for organizing analysis, documenting decisions and preparing quality conversations.</span></p>
      </article>

      <aside class="product-summary" data-reveal data-delay="1">
        <span class="product-badge product-badge--paid"><span data-lang="es">Producto destacado</span><span data-lang="en">Featured product</span></span>
        <h3><span data-lang="es">Lista para adaptar a su función.</span><span data-lang="en">Ready to adapt to your function.</span></h3>
        <div class="product-facts">
          <div class="product-fact"><span class="k"><span data-lang="es">Formatos</span><span data-lang="en">Formats</span></span><span class="v">Excel + PDF</span></div>
          <div class="product-fact"><span class="k"><span data-lang="es">Idioma</span><span data-lang="en">Language</span></span><span class="v"><span data-lang="es">Español o inglés, a elección</span><span data-lang="en">Spanish or English, your choice</span></span></div>
          <div class="product-fact"><span class="k"><span data-lang="es">Marco</span><span data-lang="en">Framework</span></span><span class="v"><span data-lang="es">Normas Globales 2024</span><span data-lang="en">2024 Global Standards</span></span></div>
          <div class="product-fact"><span class="k"><span data-lang="es">Entrega</span><span data-lang="en">Delivery</span></span><span class="v"><span data-lang="es">Descarga digital</span><span data-lang="en">Digital download</span></span></div>
        </div>
        <div class="product-price"><strong>USD 29</strong><span>COP 99.000</span></div>
        <a class="btn btn-gold" href="#compra" aria-disabled="true"><span data-lang="es">Comprar en línea</span><span data-lang="en">Buy online</span></a>
        <small><span data-lang="es">El comprador elegirá español o inglés antes de completar el pago.</span><span data-lang="en">The buyer will choose Spanish or English before completing payment.</span></small>
      </aside>
    </div>
  </div>
</section>

<section class="section section--cream">
  <div class="container">
    <div class="editorial">
      <div class="editorial-left" data-reveal><hr class="rule"><h2><span data-lang="es">¿Necesita una revisión acompañada?</span><span data-lang="en">Need a guided review?</span></h2></div>
      <div class="editorial-right" data-reveal data-delay="1"><p><span data-lang="es">La matriz también puede ser el punto de partida de un diagnóstico de brechas realizado con acompañamiento experto.</span><span data-lang="en">The matrix can also become the starting point for an expert-led gap assessment.</span></p><a class="btn btn-navy" href="/nosotros#contacto"><span data-lang="es">Consultar</span><span data-lang="en">Get in touch</span></a></div>
    </div>
  </div>
</section>

</Base>
