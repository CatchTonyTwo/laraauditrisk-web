---
import PlasmicServicesShell from './PlasmicServicesShell.jsx';

const {
  locale = 'es',
  title,
  description,
  canonicalPath = locale === 'en' ? '/en/services' : '/servicios',
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
const spanishUrl = new URL('/servicios', Astro.site);
const englishUrl = new URL('/en/services', Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#082f31" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={spanishUrl} />
    <style is:global>
      html,
      body {
        margin: 0;
        min-height: 100%;
        overflow-x: hidden;
        background: #f4f0e8;
      }

      .plasmic-services-locale,
      .plasmic-services-locale > div {
        width: 100%;
        min-height: 100vh;
      }

      .plasmic-services-locale header,
      .plasmic-services-locale section,
      .plasmic-services-locale footer {
        width: 100% !important;
        max-width: none !important;
      }

      .plasmic-services-locale section:first-of-type {
        background: #082f31 !important;
      }

      .plasmic-services-locale section:not(:first-of-type) {
        background: #f4f0e8 !important;
      }

      .plasmic-services-locale header a[href='/servicios'] + div,
      .plasmic-services-locale header a[href='/perspectivas'] + div {
        display: none !important;
      }

      .plasmic-services-locale header a[href='/nosotros#contacto'] {
        background: #0d3b3d !important;
        color: #fffdfa !important;
      }

      .plasmic-services-locale header button {
        background: transparent !important;
        color: #0d3b3d !important;
      }

      .plasmic-services-locale header button[aria-pressed='true'] {
        background: #0d3b3d !important;
        color: #fffdfa !important;
      }

      .plasmic-services-locale a:has([aria-label='Audit Risk Advisory']) {
        flex-direction: row !important;
        align-items: center !important;
        gap: 12px !important;
      }

      .plasmic-services-locale
        a:has([aria-label='Audit Risk Advisory'])
        > span:first-child {
        isolation: isolate;
        background: #0d3b3d !important;
        color: #fffdfa !important;
      }

      .plasmic-services-locale
        a:has([aria-label='Audit Risk Advisory'])
        > span:first-child::after {
        content: '';
        position: absolute;
        z-index: -1;
        width: 18px;
        height: 54px;
        right: -8px;
        top: -7px;
        background: #b86f4c;
        transform: rotate(32deg);
      }

      .plasmic-services-locale header > div,
      .plasmic-services-locale section > div,
      .plasmic-services-locale footer > div {
        width: min(1320px, calc(100% - 48px)) !important;
        max-width: 1320px !important;
        margin-right: auto !important;
        margin-left: auto !important;
      }

      @media (max-width: 700px) {
        .plasmic-services-locale header > div,
        .plasmic-services-locale section > div,
        .plasmic-services-locale footer > div {
          width: calc(100% - 32px) !important;
        }
      }
    </style>
  </head>
  <body>
    <PlasmicServicesShell {locale} client:load />
  </body>
</html>
