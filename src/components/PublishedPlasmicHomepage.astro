---
import PlasmicHomepageShell from './PlasmicHomepageShell.jsx';

const {
  locale = 'es',
  title,
  description,
  canonicalPath = locale === 'en' ? '/en/' : '/',
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site);
const spanishUrl = new URL('/', Astro.site);
const englishUrl = new URL('/en/', Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#082f31" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={spanishUrl} />
    <style is:global>
      html,
      body {
        margin: 0;
        min-height: 100%;
      }

      .plasmic-homepage-locale-en [data-set-lang='es'] {
        background: none !important;
        color: #536160 !important;
      }

      .plasmic-homepage-locale-en [data-set-lang='en'] {
        background: #0d3b3d !important;
        color: #fffdfa !important;
      }

      .plasmic-homepage-locale a:has([aria-label='Audit Risk Advisory']) {
        flex-direction: row !important;
        align-items: center !important;
        gap: 12px !important;
      }

      .plasmic-homepage-locale
        a:has([aria-label='Audit Risk Advisory'])
        > span:first-child::after {
        content: '';
        position: absolute;
        width: 18px;
        height: 54px;
        right: -8px;
        top: -7px;
        background: #b86f4c;
        transform: rotate(32deg);
      }

      .plasmic-homepage-locale [aria-label='Audit Risk Advisory'] b {
        margin-bottom: 1px;
        font: 700 0.68rem/0.68rem 'Playfair Display', Georgia, serif !important;
      }

      .plasmic-homepage-locale [aria-label='Audit Risk Advisory'] i {
        font: 600 0.39rem/0.36rem Inter, Arial, sans-serif !important;
        font-style: normal !important;
      }

      .plasmic-homepage-locale h1 em {
        color: #e6baa2;
        font-weight: 500;
      }

      .plasmic-homepage-locale header + section::before {
        content: '';
        position: absolute;
        width: min(52vw, 720px);
        aspect-ratio: 1;
        right: -11%;
        top: -28%;
        border: 1px solid rgba(230, 186, 162, 0.22);
        border-radius: 50%;
        box-shadow:
          0 0 0 60px rgba(85, 122, 112, 0.06),
          0 0 0 160px rgba(85, 122, 112, 0.035);
      }

      .plasmic-homepage-locale header + section::after {
        content: '';
        position: absolute;
        right: 8%;
        bottom: -12%;
        width: 320px;
        height: 420px;
        border: 1px solid rgba(255, 255, 255, 0.11);
        transform: rotate(16deg);
      }
    </style>
  </head>
  <body>
    <PlasmicHomepageShell {locale} client:load />
  </body>
</html>
